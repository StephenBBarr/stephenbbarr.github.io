{
  "name": "stephen-barr-portfolio",
  "private": true,
  "scripts": {
    "start": "node scripts/build.cjs --dist --local && python3 -m http.server 8000 --bind 127.0.0.1 --directory dist",
    "build": "node scripts/build.cjs",
    "build:dist": "node scripts/build.cjs --dist",
    "check:generated": "node scripts/build.cjs --check",
    "check:release": "npm test && npm run check:generated && node scripts/check-release.cjs",
    "prepare:release": "npm run check:release && npm run build:dist",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "linkedom": "0.18.13"
  }
}
